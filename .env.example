# Supabase configuration — set these in Vercel (and in .env.local for local dev).
# Never commit real values. The V0 preview runs on mock data without them;
# they're read once the Supabase backend lands.

# Public (safe to expose to the browser)
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# Server-only — NEVER expose to the browser, never commit
SUPABASE_SERVICE_ROLE_KEY=
